[WATCHDOG]
# Funktion 1: Netbird-Dienst-Watchdog – prüft periodisch ob Netbird tatsächlich
# verbunden ist (nicht nur ob der Dienst läuft) und startet ihn bei Bedarf einmalig neu.
ENABLED=1
CHECK_INTERVAL=300
RESTART_WAIT_SECONDS=20

[REBOOT_ESCALATION]
# Funktion 2: Nur wirksam wenn WATCHDOG.ENABLED=1. Wenn Netbird auch nach dem
# Dienst-Neustart nicht verbunden ist, wird einmalig ein Reboot ausgelöst
# (Cooldown siehe COOLDOWN_HOURS – verhindert Boot-Loops bei externen Ursachen).
ENABLED=0
COOLDOWN_HOURS=6

[SCHEDULED_REBOOT]
# Funktion 3: Unabhängiger, automatischer Wartungsneustart. WEEKDAYS: kommagetrennte Liste,
# 1=Montag ... 7=Sonntag (z.B. "1,4" für Montag+Donnerstag). EVERY_N: gilt für JEDEN
# ausgewählten Wochentag unabhängig – 1=jedes Mal, 2=nur jedes 2. Mal an diesem Wochentag usw.
ENABLED=0
WEEKDAYS=7
TIME=04:00
EVERY_N=1

[MQTT_WATCHDOG]
# Funktion 4: Überwacht Mosquitto-Broker UND LoxBerry MQTT-Gateway – Überwachung/Status ist
# NICHT einzeln abschaltbar (läuft immer sobald ENABLED=1), nur der automatische NEUSTART ist
# pro Dienst separat schaltbar (MOSQUITTO_AUTORESTART / GATEWAY_AUTORESTART). Eigenes,
# unabhängiges Prüfintervall (CHECK_INTERVAL) – standardmäßig deutlich kürzer als Funktion 1,
# da ein MQTT-Ausfall schneller auffallen soll.
# Mosquitto läuft als systemd-Dienst (MOSQUITTO_SERVICE ggf. anpassen: systemctl list-units
# --type=service | grep -i mqtt). Das LoxBerry MQTT-Gateway (mqttgateway.pl) ist dagegen KEIN
# systemd-Dienst, sondern ein LoxBerry-Kern-Daemon – Erkennung über GATEWAY_PROCESS_PATTERN
# (pgrep -f) und über den vom Gateway selbst veröffentlichten MQTT-Status
# (GATEWAY_MQTT_PREFIX/status + /keepaliveepoch, z.B. sichtbar als "loxberry_mqttgateway_status"
# in Loxone Config unter MQTT Virtual Inputs).
ENABLED=0
CHECK_INTERVAL=60
MOSQUITTO_AUTORESTART=1
MOSQUITTO_SERVICE=mosquitto
MOSQUITTO_HOST=127.0.0.1
MOSQUITTO_PORT=1883
GATEWAY_AUTORESTART=0
GATEWAY_PROCESS_PATTERN=mqttgateway.pl
GATEWAY_MQTT_PREFIX=loxberry/mqttgateway

[SYSTEM_DIAGNOSTICS]
# Funktion 5: System-Diagnose – überwacht typische Vor-Ort-Einsatz-Ursachen (volle SD-Karte,
# RAM-Druck, CPU-Temperatur, kein Internet, Zeitabweichung, weitere LoxBerry-Kerndienste).
# Anders als Funktion 4 ist hier JEDES Thema einzeln SOWOHL im Monitoring ALS AUCH im
# Auto-Heal schaltbar – manche Standorte sollen ggf. nur beobachtet werden. Auto-Heal
# beschränkt sich bewusst auf Dienst-/Netzwerk-Neustarts, kein Dateisystem-Remount o.ä.
ENABLED=0
CHECK_INTERVAL=120

DISK_MONITOR=1
DISK_WARN_PERCENT=85
DISK_CRIT_PERCENT=95

MEMORY_MONITOR=1
MEMORY_WARN_PERCENT=90

TEMP_MONITOR=1
TEMP_WARN_C=70
TEMP_CRIT_C=80

INTERNET_MONITOR=1
INTERNET_AUTOHEAL=0
INTERNET_HOST=1.1.1.1
INTERNET_PORT=53

TIME_MONITOR=1
TIME_AUTOHEAL=0
TIME_UNSYNCED_MIN=10

SERVICES_MONITOR=0
SERVICES_AUTOHEAL=0
SERVICES_LIST=

[MQTT]
# Optionale Statusveröffentlichung an Loxone (Verbindungsstatus, letzte Aktionen).
# Rein informativ – die Watchdog-Logik selbst ist von MQTT vollständig unabhängig.
ENABLED=1
USE_LOXBERRY_MQTT=1
BROKER=127.0.0.1
PORT=1883
USER=
PASS=
TOPIC_PREFIX=HitWatch/netbird_watchdog
