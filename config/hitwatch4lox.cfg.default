[WATCHDOG]
# Funktion 1: Netbird-Dienst-Watchdog – prüft periodisch ob Netbird tatsächlich
# verbunden ist (nicht nur ob der Dienst läuft) und startet ihn bei Bedarf einmalig neu.
ENABLED=1
CHECK_INTERVAL=300
RESTART_WAIT_SECONDS=20

[REBOOT_ESCALATION]
# Funktion 2: Nur wirksam wenn WATCHDOG.ENABLED=1. Wenn Netbird auch nach dem
# Dienst-Neustart nicht verbunden ist, wird einmalig ein Reboot ausgelöst
# (Cooldown siehe COOLDOWN_HOURS – verhindert Boot-Loops bei externen Ursachen).
ENABLED=0
COOLDOWN_HOURS=6

[SCHEDULED_REBOOT]
# Funktion 3: Unabhängiger, automatischer Wartungsneustart. WEEKDAYS: kommagetrennte Liste,
# 1=Montag ... 7=Sonntag (z.B. "1,4" für Montag+Donnerstag). EVERY_N: gilt für JEDEN
# ausgewählten Wochentag unabhängig – 1=jedes Mal, 2=nur jedes 2. Mal an diesem Wochentag usw.
ENABLED=0
WEEKDAYS=7
TIME=04:00
EVERY_N=1

[MQTT_WATCHDOG]
# Funktion 4: Überwacht Mosquitto-Broker und/oder LoxBerry MQTT-Gateway unabhängig voneinander
# und startet den jeweiligen systemd-Dienst bei Bedarf neu. Nutzt dasselbe Prüfintervall wie
# Funktion 1 (WATCHDOG.CHECK_INTERVAL). Dienstnamen sind je nach LoxBerry-Setup ggf. anzupassen
# (systemctl list-units --type=service | grep -i mqtt hilft beim Ermitteln).
ENABLED=0
MOSQUITTO_ENABLED=1
MOSQUITTO_SERVICE=mosquitto
MOSQUITTO_HOST=127.0.0.1
MOSQUITTO_PORT=1883
GATEWAY_ENABLED=0
GATEWAY_SERVICE=mqttgateway

[MQTT]
# Optionale Statusveröffentlichung an Loxone (Verbindungsstatus, letzte Aktionen).
# Rein informativ – die Watchdog-Logik selbst ist von MQTT vollständig unabhängig.
ENABLED=1
USE_LOXBERRY_MQTT=1
BROKER=127.0.0.1
PORT=1883
USER=
PASS=
TOPIC_PREFIX=HitWatch/netbird_watchdog
